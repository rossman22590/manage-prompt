APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000

# Auth
AUTH_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Comma-separated list of extra domains this app is deployed to (besides
# APP_BASE_URL), e.g. "https://otherdomain.com,https://another.example.com".
# Required for magic-link/auth to work correctly from those domains -- the
# app no longer hardcodes a single baseURL, so any origin that should be
# trusted must be listed here (or via APP_BASE_URL) explicitly.
ADDITIONAL_TRUSTED_ORIGINS=

# Upstash
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN= 

# AI Cloud
OPENROUTER_API_KEY=
FIRECRAWL_API_KEY=

# Feature flags
# Set to "false" to disable the Agents feature (dashboard pages, nav link, and
# public API). Any other value (or leaving it unset) keeps it enabled.
AGENTS_FEATURE_ENABLED=

# Set to "true" to enable email+password sign-in/sign-up as an alternative to
# magic-link. Local/dev convenience only -- leave unset (or anything other
# than "true") everywhere else; must never be set on a deployed environment.
ENABLE_PASSWORD_AUTH=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WORKFLOW_RUN_PRICE_ID=
STRIPE_COUPON_ID=

# DB
DATABASE_URL=""
